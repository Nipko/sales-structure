# ============================================
# Parallext Engine — Environment Variables
# Copy this file as .env and fill in the values
# ============================================

# ---- General ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Authentication ----
# Shared JWT secret between API and WhatsApp services (min 32 chars)
INTERNAL_JWT_SECRET=your_jwt_secret_here_min_32_chars
# JWT token expiration
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---- Database ----
DATABASE_URL=postgresql://parallext:parallext_secret@localhost:6432/parallext_engine?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://parallext:parallext_secret@localhost:5432/parallext_engine
DB_PASSWORD=parallext_secret

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- API Service (port 3000) ----
API_PORT=3000
DASHBOARD_URL=http://localhost:3001

# ---- WhatsApp Service (port 3002) ----
WA_PORT=3002

# ---- Encryption ----
# 64-char hex string (32 bytes) for AES-256-GCM encryption of channel tokens
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ---- Internal Service-to-Service Communication ----
# Base URL for the API as seen from the WhatsApp microservice (docker service name)
API_INTERNAL_URL=http://api:3000/api/v1
# Shared secret for service-to-service auth via x-internal-key header (min 32 chars)
INTERNAL_API_KEY=change_me_to_a_random_secret_min_32_chars

# ---- Meta / WhatsApp Cloud API ----
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_custom_verify_token
META_CONFIG_ID=your_facebook_login_config_id
META_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
# System User ID from your Meta Business Manager (for permanent tokens)
# Create in: business.facebook.com → Settings → System Users
SYSTEM_USER_ID=

# ---- Frontend (Next.js Dashboard) ----
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WA_SERVICE_URL=http://localhost:3002/api/v1
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
NEXT_PUBLIC_META_CONFIG_ID=your_facebook_login_config_id
# Solution ID from Meta Partner Center (required for Tech Provider Embedded Signup)
NEXT_PUBLIC_META_SOLUTION_ID=

# ---- Web Push (PWA notifications) ----
# Generate a key pair with: npx web-push generate-vapid-keys
# The public key must ALSO be exposed to the dashboard build as NEXT_PUBLIC_VAPID_PUBLIC_KEY (same value).
# Without these, push notifications are gracefully disabled.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# ---- Error Tracking ----
SENTRY_DSN=
# Ops-center error-rate alerts: Sentry internal/integration token (org:read +
# project:read) + org slug. SENTRY_PROJECT (numeric id) narrows to one project,
# else org-wide. SENTRY_API_URL only for self-hosted. Optional — silent if unset.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_API_URL=

# ---- Platform Alerts (ops center) ----
# Dedicated Telegram bot for super_admin incident alerts (separate from tenant
# customer bots). Create a bot via @BotFather, then get the chat id by messaging
# the bot and reading https://api.telegram.org/bot<token>/getUpdates. Optional —
# alerts fall back to email when unset.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ---- Platform SMS alerts (ops center) ----
# Dedicated Twilio account for critical super_admin SMS alerts. Separate from the
# per-tenant customer SMS channel. Optional — SMS alerts are a no-op when unset
# (email/Telegram still fire). SMS_ALERT_TO accepts comma-separated E.164 numbers.
SMS_ALERT_ACCOUNT_SID=
SMS_ALERT_AUTH_TOKEN=
SMS_ALERT_FROM=
SMS_ALERT_TO=

# ---- Tenant notification SMS sender (reseller packages) ----
# Commercial sender for tenant→customer notification SMS (monetized credit
# packages). Reuses the platform Twilio account above (SMS_ALERT_ACCOUNT_SID /
# _AUTH_TOKEN). Optional — falls back to SMS_ALERT_FROM when unset. Use a
# dedicated long code / alphanumeric sender so commercial notifications don't
# share the internal ops-alert number.
SMS_SENDER_ID=

# ---- Google OAuth ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.parallly-chat.cloud/api/v1/calendar/google/callback

# ---- Microsoft Calendar (optional) ----
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_CALENDAR_REDIRECT_URI=https://api.parallly-chat.cloud/api/v1/calendar/microsoft/callback

# ---- MercadoPago ----
# RETIRADO como pasarela de plataforma (ago 2026). No hay credenciales de
# MercadoPago a nivel plataforma: las suscripciones las cobra Wompi (abajo).
# El tenant que quiera cobrar a SUS clientes con su propia cuenta de MercadoPago
# la configura desde el panel (Configuración → Integraciones → Pagos); ese token
# se guarda cifrado por tenant en la base y nunca pasa por estas variables.

# ---- Wompi (Bancolombia — Colombian billing rail) ----
# Get them at comercios.wompi.co → Desarrolladores → "Secretos para integración
# técnica". Sandbox keys are issued instantly on signup; production keys unlock
# after merchant activation and the documents Wompi requests for the account.
# The settlement account accepted during onboarding can depend on Wompi's
# current merchant flow (for example Bancolombia or Nequi); do not confuse that
# destination account with the Bancolombia payment method offered to payers.
#
# ONE set of four variables — and four GitHub Secrets with exactly these names.
# There is no separate sandbox/production pair and no "mode" flag: the key
# PREFIX decides the environment and the API base URL, so a test key can never
# accidentally hit production and the two can never fall out of sync.
#   pub_test_/prv_test_/test_events_/test_integrity_   → https://sandbox.wompi.co/v1
#   pub_prod_/prv_prod_/prod_events_/prod_integrity_   → https://production.wompi.co/v1
#
# Going live is therefore a VALUE swap on these same four secrets, not a rename.
# Mixing a test key with a production one disables the adapter outright rather
# than charging real money from a test flow.
#
# Which provider actually bills a country is runtime configuration
# (/admin/plans → Proveedores), NOT these variables. The current production
# migration enables Wompi for Colombia, so all six operational values below are
# mandatory before deploying that migration.
#
# Publishable key — goes to the browser for card tokenization (single-use tokens
# only). Served to the frontend at runtime via GET /billing/public/config, so
# switching operators never needs a dashboard rebuild.
WOMPI_PUBLIC_KEY=
# Private key — server-side only: creates payment sources and charges.
WOMPI_PRIVATE_KEY=
# Events key — verifies the SHA-256 checksum of incoming webhooks. Without it,
# webhook verification fails closed and no charge is ever confirmed.
WOMPI_EVENTS_SECRET=
# Integrity key — signs every transaction (SHA256 of reference + amount +
# currency + this secret). The WORKER needs it too: it signs each renewal.
WOMPI_INTEGRITY_SECRET=
# Contractual ceilings in COP cents (COP 1 = 100). The renewal engine fails
# closed when the per-transaction limit is absent and defers at the daily cap.
WOMPI_MAX_TRANSACTION_COP_CENTS=
WOMPI_DAILY_CAP_COP_CENTS=
# Shared merchant-day boundary for the global Wompi cap (IANA timezone).
WOMPI_MERCHANT_TIMEZONE=America/Bogota
# Isolated staging only. Never set this on the production tenant environment.
WOMPI_ALLOW_SANDBOX_IN_PRODUCTION=false
# URL Wompi posts events to. Configure the same value in the Wompi dashboard,
# separately for each environment.
WOMPI_WEBHOOK_URL=http://localhost:3000/api/v1/billing/webhook/wompi

# ---- Factus (DIAN electronic invoicing — Colombia) ----
# Credentials provided by the Factus (Halltec) admin. Sandbox base URL until
# production go-live. FACTUS_USERNAME is the account EMAIL. The numbering range,
# IVA treatment and fiscal mode are managed from the super admin (DB-backed),
# NOT here. Issued via POST /v2/bills/validate; OAuth2 password grant.
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
# Where the signed XML + PDF copies are archived for the 5-year DIAN retention.
# Defaults to /data/invoices (persisted on the same volume as /data/media).
FISCAL_STORAGE_PATH=/data/invoices

# ---- SMTP (Email) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Parallly <noreply@parallly.com>
# Managed inbound Email webhook (authenticated application/json only). A trusted
# provider adapter/reverse proxy must translate upstream multipart and inject
# this header. Direct SendGrid Inbound Parse multipart is not accepted.
# Required to accept POST /api/v1/channels/email/inbound; when empty, the
# endpoint fails closed (503).
# Generate with: openssl rand -hex 32
EMAIL_INBOUND_WEBHOOK_SECRET=
EMAIL_INBOUND_WEBHOOK_HEADER=x-email-webhook-secret
# The adapter processes message text/HTML and metadata, not attachment blobs.
EMAIL_INBOUND_MAX_BODY_BYTES=1048576
EMAIL_INBOUND_RATE_LIMIT_PER_MINUTE=600
EMAIL_INBOUND_RECIPIENT_RATE_LIMIT_PER_MINUTE=120

# ---- AI Providers (at least one required) ----
# The LLM Router auto-selects available providers. Unconfigured ones are skipped.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ---- RAG / Embeddings ----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- Production Only ----
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token

{
    "name": "@parallext/api",
    "version": "4.0.0",
    "private": true,
    "description": "Parallext Engine - NestJS Backend API",
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "node dist/main",
        "start:worker": "node dist/worker.main",
        "start:debug": "nest start --debug --watch",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:bootstrap": "jest --testPathPattern=bootstrap --forceExit",
        "test:migrate:tenants": "node scripts/test-tenant-migration.js",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "db:migrate": "prisma migrate dev",
        "db:seed": "ts-node prisma/seed.ts",
        "db:seed:gecko": "psql $DATABASE_URL -f prisma/seed-gecko.sql",
        "db:studio": "prisma studio",
        "migrate:tenants": "node scripts/migrate-tenants.js",
        "reconcile:vertical-provisioning": "node scripts/reconcile-vertical-provisioning.js"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.78.0",
        "@azure/msal-node": "^5.1.2",
        "@bull-board/api": "^7.0.0",
        "@bull-board/express": "^7.0.0",
        "@bull-board/nestjs": "^7.0.0",
        "@google/generative-ai": "^0.21.0",
        "@microsoft/microsoft-graph-client": "^3.0.7",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/bullmq": "^10.2.0",
        "@nestjs/common": "^10.4.0",
        "@nestjs/config": "^3.2.0",
        "@nestjs/core": "^10.4.0",
        "@nestjs/event-emitter": "^3.0.1",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.0",
        "@nestjs/platform-socket.io": "^10.4.22",
        "@nestjs/schedule": "^4.1.0",
        "@nestjs/swagger": "^7.4.0",
        "@nestjs/websockets": "^10.4.22",
        "@node-saml/passport-saml": "^5.1.0",
        "@parallext/shared": "*",
        "@prisma/client": "^5.20.0",
        "@sentry/nestjs": "^10.48.0",
        "@sentry/profiling-node": "^10.48.0",
        "@types/pdfkit": "^0.17.6",
        "axios": "^1.13.6",
        "bcrypt": "^5.1.1",
        "bullmq": "^5.25.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "google-auth-library": "^10.6.2",
        "googleapis": "^171.4.0",
        "helmet": "^7.1.0",
        "ical-generator": "^10.2.0",
        "ioredis": "^5.4.0",
        "js-yaml": "^4.1.0",
        "mammoth": "^1.12.0",
        "mercadopago": "^2.12.0",
        "nestjs-pino": "^4.6.1",
        "node-ical": "^0.26.0",
        "nodemailer": "^8.0.2",
        "openai": "^4.70.0",
        "otpauth": "^9.5.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pdf-parse": "^1.1.1",
        "pdfkit": "^0.18.0",
        "pg": "^8.21.0",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "pino-roll": "^4.0.0",
        "qrcode": "^1.5.4",

        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/js-yaml": "^4.0.9",
        "@types/multer": "^2.1.0",
        "@types/node": "^20.14.0",
        "@types/nodemailer": "^7.0.11",
        "@types/passport-jwt": "^4.0.1",
        "@types/qrcode": "^1.5.6",
        "@types/uuid": "^10.0.0",
        "@types/web-push": "^3.6.4",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "prisma": "^5.20.0",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.2.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.0"
    }

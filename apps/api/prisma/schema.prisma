// Parallext Engine - Prisma Schema
// Multi-tenant platform with schema-per-tenant strategy

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgvector(map: "vector"), uuid_ossp(map: "uuid-ossp")]
  schemas    = ["public"]
}

// ============================================
// PUBLIC SCHEMA — Global tables
// ============================================

// ---- Tenants (Client businesses) ----
model Tenant {
  id         String  @id @default(uuid())
  name       String
  slug       String  @unique
  industry   String
  language   String  @default("es-CO")
  schemaName String  @unique @map("schema_name")
  isActive   Boolean @default(true) @map("is_active")
  plan       String  @default("starter")
  settings   Json    @default("{}")

  // Billing — denormalized hot-path fields. Source of truth for full
  // subscription state is the BillingSubscription row linked via the
  // one-to-one relation below. These columns exist so the rate limiter and
  // middleware can decide access without joining billing_subscriptions per
  // request. Kept in sync by BillingService on every state transition.
  billingEmail              String?   @map("billing_email")
  billingCountry            String?   @map("billing_country")
  subscriptionStatus        String?   @map("subscription_status") // pending_auth|trialing|active|past_due|cancelled|expired
  trialEndsAt               DateTime? @map("trial_ends_at")
  currentPeriodEnd          DateTime? @map("current_period_end")
  paymentProvider           String?   @map("payment_provider") // mercadopago|stripe|mock
  paymentProviderCustomerId String?   @map("payment_provider_customer_id")

  // Onboarding funnel tracking — used by /admin/funnel cohort analysis
  onboardingCompletedAt    DateTime? @map("onboarding_completed_at")
  firstChannelConnectedAt  DateTime? @map("first_channel_connected_at") // TTFV: first channel ever connected
  firstMessageAt           DateTime? @map("first_message_at")
  signupSource             String?   @map("signup_source") // landing_page|api|partner|...

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  channelAccounts ChannelAccount[]
  subscription    BillingSubscription?
  invitations     TenantInvitation[]

  @@map("tenants")
  @@schema("public")
}

// ---- Users (Platform users: admins, agents) ----
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String?
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  role                String    @default("tenant_agent")
  tenantId            String?   @map("tenant_id")
  isActive            Boolean   @default(true) @map("is_active")
  authProvider        String    @default("email") @map("auth_provider")
  googleId            String?   @map("google_id")
  microsoftId         String?   @map("microsoft_id")
  picture             String?
  emailVerified       Boolean   @default(false) @map("email_verified")
  emailVerifyCode     String?   @map("email_verify_code")
  emailVerifyExpires  DateTime? @map("email_verify_expires")
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?   @map("two_factor_secret")
  twoFactorMethod     String?   @map("two_factor_method")
  backupCodes         String[]  @default([]) @map("backup_codes")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  phone               String?
  jobTitle            String?   @map("job_title")
  availabilityStatus  String    @default("offline") @map("availability_status")
  maxCapacity         Int       @default(5) @map("max_capacity")
  skillTags           String[]  @default([]) @map("skill_tags")
  lastActiveAt        DateTime? @map("last_active_at")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trustedDevices TrustedDevice[]

  @@index([tenantId])
  @@map("users")
  @@schema("public")
}

// ---- Platform Settings (global key/value config; accessed via raw SQL) ----
// Modeled so Prisma is aware of the table (created in migration
// 20260623000000_add_user_fields_and_platform_settings); the app reads/writes it
// through $queryRaw/$executeRaw, not the typed client.
model PlatformSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     String?
  isSecret  Boolean  @default(false) @map("is_secret")
  category  String   @default("general")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
  @@schema("public")
}

// ---- Channel Accounts (WhatsApp numbers, IG accounts, etc.) ----
model ChannelAccount {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  channelType   String   @map("channel_type") // whatsapp, instagram, messenger, telegram
  accountId     String   @map("account_id") // Phone number / page ID / bot token
  displayName   String   @map("display_name")
  accessToken   String   @map("access_token") // Encrypted
  refreshToken  String?  @map("refresh_token") // Encrypted
  webhookSecret String?  @map("webhook_secret")
  isActive      Boolean  @default(true) @map("is_active")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([channelType, accountId])
  @@index([tenantId])
  @@map("channel_accounts")
  @@schema("public")
}

// ---- Audit Log ----
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  tenantId  String?  @map("tenant_id")
  action    String
  resource  String
  details   Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
  @@schema("public")
}

// ---- Tenant Invitations ----
// Email-based invitation flow: admin creates a token, an email goes out
// with /accept-invite/{token}, and the recipient sets their own password
// (or signs in via Google) to activate. Tokens are single-use, expire in
// 14 days, and can be revoked or resent before acceptance.
model TenantInvitation {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  email           String // lowercased, normalized
  role            String // tenant_admin | tenant_supervisor | tenant_agent
  skillTags       String[]  @default([]) @map("skill_tags")
  token           String    @unique // crypto-random, used in the magic link
  invitedByUserId String?   @map("invited_by_user_id")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  acceptedUserId  String?   @map("accepted_user_id")
  revokedAt       DateTime? @map("revoked_at")
  resentAt        DateTime? @map("resent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, acceptedAt])
  @@index([email])
  @@map("tenant_invitations")
  @@schema("public")
}

// ---- Trusted Devices (2FA bypass for remembered browsers) ----
model TrustedDevice {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  tokenHash       String   @unique @map("token_hash")
  deviceName      String   @map("device_name")
  userAgent       String?  @map("user_agent")
  fingerprintHash String?  @map("fingerprint_hash")
  ipAddress       String?  @map("ip_address")
  expiresAt       DateTime @map("expires_at")
  lastUsedAt      DateTime @default(now()) @map("last_used_at")
  isRevoked       Boolean  @default(false) @map("is_revoked")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_devices")
  @@schema("public")
}

// ---- WhatsApp Onboarding ----
model WhatsappOnboarding {
  id                      String  @id @default(uuid())
  tenantId                String  @map("tenant_id")
  configId                String  @map("config_id")
  mode                    String  @default("new") // new, existing, coexistence
  status                  String  @default("CREATED") // OnboardingStatus enum
  isCoexistence           Boolean @default(false) @map("is_coexistence")
  coexistenceAcknowledged Boolean @default(false) @map("coexistence_acknowledged")

  // Meta assets discovered
  metaBusinessId     String? @map("meta_business_id")
  wabaId             String? @map("waba_id")
  phoneNumberId      String? @map("phone_number_id")
  displayPhoneNumber String? @map("display_phone_number")
  verifiedName       String? @map("verified_name")

  // Exchange data
  exchangePayload Json? @map("exchange_payload")

  // Error tracking
  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")

  // Who started the onboarding
  startedByUserId String? @map("started_by_user_id")

  // Timestamps
  codeReceivedAt      DateTime? @map("code_received_at")
  exchangeCompletedAt DateTime? @map("exchange_completed_at")
  assetsSyncedAt      DateTime? @map("assets_synced_at")
  webhookValidatedAt  DateTime? @map("webhook_validated_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([status])
  @@map("whatsapp_onboardings")
  @@schema("public")
}

// ---- WhatsApp Credentials (encrypted) ----
model WhatsappCredential {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  credentialType String    @map("credential_type") // system_user_token, app_secret
  encryptedValue String    @map("encrypted_value") // AES-256-GCM encrypted
  rotationState  String    @default("active") @map("rotation_state") // active, rotating, revoked
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, credentialType])
  @@map("whatsapp_credentials")
  @@schema("public")
}

// ============================================
// BILLING — Global tables (cross-tenant)
// ============================================

// ---- Billing Plans ----
// Catalog of subscription tiers. Prices stored in USD cents (source of truth);
// per-country local currency equivalents live in priceLocalOverrides JSONB:
//   { "AR": { "currency": "ARS", "amountCents": 4890000 }, "MX": { ... } }
// Provider-specific plan IDs (MercadoPago preapproval_plan_id, Stripe price_id)
// are populated after creating the plan on each provider.
model BillingPlan {
  id                   String   @id @default(uuid())
  slug                 String   @unique // starter | pro | enterprise | custom
  name                 String
  priceUsdCents        Int      @map("price_usd_cents")
  trialDays            Int      @default(0) @map("trial_days")
  requiresCardForTrial Boolean  @default(false) @map("requires_card_for_trial")
  maxAgents            Int      @map("max_agents")
  maxAiMessages        Int      @map("max_ai_messages")
  features             Json     @default("{}")
  mpPlanId             String?  @map("mp_plan_id")
  stripePlanId         String?  @map("stripe_plan_id")
  priceLocalOverrides  Json     @default("{}") @map("price_local_overrides")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  subscriptions BillingSubscription[]
  pendingFor    BillingSubscription[] @relation("PendingPlan")

  @@map("billing_plans")
  @@schema("public")
}

// ---- Billing Subscriptions ----
// One active subscription per tenant (tenantId @unique). Status is our
// normalized SubscriptionStatus enum; each provider adapter translates its
// own vocabulary on read. Lifecycle transitions are orchestrated by
// BillingService — do not mutate status directly.
model BillingSubscription {
  id                     String    @id @default(uuid())
  tenantId               String    @unique @map("tenant_id")
  planId                 String    @map("plan_id")
  status                 String // pending_auth|trialing|active|past_due|cancelled|expired
  provider               String // mercadopago|stripe|mock
  providerSubscriptionId String?   @unique @map("provider_subscription_id")
  providerCustomerId     String?   @map("provider_customer_id")
  trialStartedAt         DateTime? @map("trial_started_at")
  trialEndsAt            DateTime? @map("trial_ends_at")
  currentPeriodStart     DateTime? @map("current_period_start")
  currentPeriodEnd       DateTime? @map("current_period_end")
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt            DateTime? @map("cancelled_at")
  cancellationReason     String?   @map("cancellation_reason")
  // Pending plan change — when user downgrades, we don't switch immediately.
  // We store the target plan + scheduled date and apply it when the period
  // ends (via a daily cron in BillingReconciliationProcessor). Setting these
  // also signals the dashboard to show "your plan will switch on YYYY-MM-DD".
  pendingPlanId          String?   @map("pending_plan_id")
  pendingPlanChangeAt    DateTime? @map("pending_plan_change_at")
  metadata               Json      @default("{}")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        BillingPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  pendingPlan BillingPlan?     @relation("PendingPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  payments    BillingPayment[]
  events      BillingEvent[]

  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEnd])
  @@map("billing_subscriptions")
  @@schema("public")
}

// ---- Billing Events ----
// Append-only log of every normalized billing event BillingService processes.
// Doubles as the idempotency store: (provider, providerEventId) must be unique
// so a webhook redelivery is skipped on the second processing attempt.
model BillingEvent {
  id              String   @id @default(uuid())
  tenantId        String?  @map("tenant_id")
  subscriptionId  String?  @map("subscription_id")
  provider        String
  providerEventId String   @map("provider_event_id")
  eventType       String   @map("event_type") // BillingEventType enum as string
  payload         Json // raw provider payload for audit
  processedAt     DateTime @default(now()) @map("processed_at")

  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([tenantId, processedAt])
  @@index([eventType])
  @@map("billing_events")
  @@schema("public")
}

// ---- Billing Payments ----
// Individual charge history for invoices, dashboard, and fiscal integration.
// amountCents is in the currency stored in `currency` (USD or local).
// invoicePdfUrl and invoiceNumber are populated by the fiscal integration
// (Facturapi / Alegra / Quaderno) in Phase 4 — nullable until then.
model BillingPayment {
  id                String    @id @default(uuid())
  subscriptionId    String    @map("subscription_id")
  tenantId          String    @map("tenant_id")
  amountCents       Int       @map("amount_cents")
  currency          String // USD | ARS | MXN | COP | CLP | PEN | UYU | BRL
  status            String // succeeded | failed | refunded | pending
  provider          String
  providerPaymentId String?   @unique @map("provider_payment_id")
  paidAt            DateTime? @map("paid_at")
  failureReason     String?   @map("failure_reason")
  invoiceNumber     String?   @map("invoice_number")
  invoicePdfUrl     String?   @map("invoice_pdf_url")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")

  subscription BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("billing_payments")
  @@schema("public")
}

// ---- Fiscal Invoices (DIAN electronic invoicing — Colombia) ----
// Dedicated fiscal document lifecycle, decoupled from the payment provider.
// Created on billing.payment.succeeded (any PSP), issued async via a fiscal
// provider adapter (Factus today). Holds the legally-relevant fiscal artifacts
// (CUFE, numbering, signed XML/PDF) plus an immutable acquirer snapshot so
// historical invoices keep the exact data billed even if the tenant later edits
// its fiscal profile. status: pending|issued|failed|cancelled.
model FiscalInvoice {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  paymentId        String?   @unique @map("payment_id") // BillingPayment.id; null for standalone credit notes
  type             String    @default("invoice") // invoice | credit_note | debit_note
  status           String    @default("pending") // pending | issued | failed | cancelled
  provider         String // factus | us_remote | ...
  providerRef      String?   @map("provider_ref") // Factus internal bill_id (needed for credit notes)
  cufe             String? // CUFE / CUDE assigned by DIAN
  invoiceNumber    String?   @map("invoice_number") // prefix + consecutive (e.g. SETP990000001)
  xmlUrl           String?   @map("xml_url")
  pdfUrl           String?   @map("pdf_url")
  qrUrl            String?   @map("qr_url")
  amountCents      Int       @map("amount_cents")
  currency         String // COP (fiscal currency); original charge currency kept in metadata
  taxCents         Int       @default(0) @map("tax_cents") // IVA amount
  relatedInvoiceId String?   @map("related_invoice_id") // credit note -> original FiscalInvoice.id
  failureReason    String?   @map("failure_reason")
  attempts         Int       @default(0)
  metadata         Json      @default("{}") // trmApplied, paymentProvider, raw provider errors
  acquirerSnapshot Json?     @map("acquirer_snapshot") // immutable copy of acquirer fiscal data at issue time
  issuedAt         DateTime? @map("issued_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([paymentId])
  @@map("fiscal_invoices")
  @@schema("public")
}

// ---- Billing Coupons ----
// Promo codes that apply at trial start or upgrade. Three types:
//   percent_off: percentDiscount (1-100) applies to N billing cycles (or forever)
//   amount_off : amountOffCents reduced from each charge for N cycles
//   free_months: extends the free trial by N months (no charge during the gift period)
// Redemption tracking is via BillingCouponRedemption — a tenant can redeem each
// code once. maxRedemptions caps total platform-wide usage; null = unlimited.
model BillingCoupon {
  id               String    @id @default(uuid())
  code             String    @unique // user-facing code, uppercase normalized
  description      String?
  type             String // percent_off | amount_off | free_months
  percentDiscount  Int?      @map("percent_discount") // 1-100 when type=percent_off
  amountOffCents   Int?      @map("amount_off_cents") // when type=amount_off
  freeMonths       Int?      @map("free_months") // when type=free_months
  durationCycles   Int?      @map("duration_cycles") // for percent_off / amount_off — null = forever
  appliesToPlanIds String[]  @default([]) @map("applies_to_plan_ids") // empty = any plan
  maxRedemptions   Int?      @map("max_redemptions") // null = unlimited
  redemptionCount  Int       @default(0) @map("redemption_count")
  expiresAt        DateTime? @map("expires_at")
  isActive         Boolean   @default(true) @map("is_active")
  createdByUserId  String?   @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  redemptions BillingCouponRedemption[]

  @@index([isActive, expiresAt])
  @@map("billing_coupons")
  @@schema("public")
}

// ---- Coupon Redemptions ----
// One row per tenant×coupon. Prevents reuse and lets us audit who redeemed what.
model BillingCouponRedemption {
  id              String   @id @default(uuid())
  couponId        String   @map("coupon_id")
  tenantId        String   @map("tenant_id")
  subscriptionId  String?  @map("subscription_id")
  redeemedAt      DateTime @default(now()) @map("redeemed_at")
  cyclesRemaining Int?     @map("cycles_remaining") // counts down on each charge for percent/amount
  metadata        Json     @default("{}")

  coupon BillingCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, tenantId])
  @@index([tenantId])
  @@map("billing_coupon_redemptions")
  @@schema("public")
}

// ============================================
// SMS CREDITS — Monetized one-way notification packages (reseller)
// ============================================
// Tenants buy prepaid SMS credit packages to notify their own customers via the
// PLATFORM Twilio sender (reseller model). 1 credit = 1 Twilio message segment.
// The conversational SMS channel (BYO, bidirectional) is intentionally out of scope.

// ---- SMS Credit Balance (global) ----
// Current prepaid balance per tenant. Mutated only through SmsCreditsService
// (atomic UPDATE ... RETURNING). The ledger is the auditable source of truth;
// this row is the fast-read cache of the running total.
model SmsCreditBalance {
  id             String   @id @default(uuid())
  tenantId       String   @unique @map("tenant_id")
  balanceCredits Int      @default(0) @map("balance_credits")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("sms_credit_balances")
  @@schema("public")
}

// ---- SMS Credit Ledger (global) ----
// Append-only movements: +purchase / -consumption / ±adjustment / +refund.
// balanceAfter snapshots the running total post-movement. (reason, ref) is used
// for idempotency on purchases (skip if a row with the same ref already exists).
model SmsCreditLedger {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  delta        Int // signed: positive = credited, negative = consumed
  reason       String // purchase | consumption | adjustment | refund
  ref          String? // orderId / campaignId / paymentId / admin userId
  balanceAfter Int      @map("balance_after")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, reason, ref])
  @@map("sms_credit_ledger")
  @@schema("public")
}

// ---- SMS Package Order (global) ----
// One-time purchase of a credit package. The order id is used as the MercadoPago
// external_reference; the payment webhook resolves the order and credits the
// balance (idempotent). status: pending | paid | failed | cancelled.
model SmsPackageOrder {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  packageId   String    @map("package_id") // tier slug at purchase time
  credits     Int
  priceCents  Int       @map("price_cents") // minor units of `currency`
  currency    String    @default("COP")
  status      String    @default("pending") // pending | paid | failed | cancelled
  provider    String    @default("mercadopago")
  providerRef String?   @map("provider_ref") // preference id / payment id
  initPoint   String?   @map("init_point") // MP hosted checkout URL
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([status, createdAt])
  @@map("sms_package_orders")
  @@schema("public")
}

// ============================================
// FINANCIALS — Platform-level SaaS metrics
// ============================================

// ---- Monthly Financial Snapshot (global) ----
model FinancialSnapshot {
  id                    String   @id @default(uuid())
  snapshotMonth         DateTime @unique @map("snapshot_month")
  mrrCents              Int      @default(0) @map("mrr_cents")
  newMrrCents           Int      @default(0) @map("new_mrr_cents")
  expansionMrrCents     Int      @default(0) @map("expansion_mrr_cents")
  contractionMrrCents   Int      @default(0) @map("contraction_mrr_cents")
  churnedMrrCents       Int      @default(0) @map("churned_mrr_cents")
  reactivationMrrCents  Int      @default(0) @map("reactivation_mrr_cents")
  activeCustomers       Int      @default(0) @map("active_customers")
  newCustomers          Int      @default(0) @map("new_customers")
  churnedCustomers      Int      @default(0) @map("churned_customers")
  trialingCustomers     Int      @default(0) @map("trialing_customers")
  trialsStarted         Int      @default(0) @map("trials_started")
  trialsConverted       Int      @default(0) @map("trials_converted")
  revenueCollectedCents Int      @default(0) @map("revenue_collected_cents")
  paymentsSucceeded     Int      @default(0) @map("payments_succeeded")
  paymentsFailed        Int      @default(0) @map("payments_failed")
  llmCostCents          Int      @default(0) @map("llm_cost_cents")
  infraCostCents        Int      @default(0) @map("infra_cost_cents")
  planDistribution      Json     @default("{}") @map("plan_distribution")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("financial_snapshots")
  @@schema("public")
}

// ---- Per-Tenant Monthly Snapshot ----
model TenantFinancialSnapshot {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  snapshotMonth DateTime @map("snapshot_month")
  planSlug      String   @map("plan_slug")
  mrrCents      Int      @default(0) @map("mrr_cents")
  status        String
  revenueCents  Int      @default(0) @map("revenue_cents")
  llmCostCents  Int      @default(0) @map("llm_cost_cents")
  aiMessages    Int      @default(0) @map("ai_messages")
  conversations Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([tenantId, snapshotMonth])
  @@map("tenant_financial_snapshots")
  @@schema("public")
}

// ---- Daily Storage Snapshot (disk fill projection + trend + quota alerts) ----
model StorageSnapshot {
  id           String   @id @default(uuid())
  snapshotDate DateTime @map("snapshot_date")
  tenantId     String   @map("tenant_id") // tenant uuid, or 'platform' for the platform-wide row
  dbBytes      BigInt   @default(0) @map("db_bytes")
  mediaBytes   BigInt   @default(0) @map("media_bytes")
  diskUsedPct  Int?     @map("disk_used_pct") // only set on the 'platform' row
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([snapshotDate, tenantId])
  @@map("storage_snapshots")
  @@schema("public")
}

// ---- Platform Incidents (persistent alerts for the ops center) ----
model PlatformIncident {
  id             String    @id @default(uuid())
  key            String // alert key, e.g. 'disk:critical', 'storage:tenant:<id>'
  severity       String    @default("warning") // info | warning | critical
  title          String
  body           String?
  value          Float?
  status         String    @default("active") // active | acknowledged | resolved
  count          Int       @default(1) // times re-fired while open
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by")
  resolvedAt     DateTime? @map("resolved_at")
  resolvedBy     String?   @map("resolved_by") // user email, or 'system' for auto-resolve
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status, severity])
  @@index([key])
  @@map("platform_incidents")
  @@schema("public")
}

// ---- Infrastructure Costs ----
model InfraCost {
  id          String   @id @default(uuid())
  month       DateTime
  category    String
  description String?
  amountCents Int      @map("amount_cents")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([month, category])
  @@map("infra_costs")
  @@schema("public")
}

// ---- Exchange Rates ----
model ExchangeRate {
  id           String   @id @default(uuid())
  rateDate     DateTime @map("rate_date")
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal
  source       String   @default("manual")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([rateDate, fromCurrency, toCurrency])
  @@map("exchange_rates")
  @@schema("public")
}

// ============================================
// FEATURE REQUESTS — Global board (cross-tenant)
// ============================================
// Single global board: tenants submit and vote on Parallly platform features.
// No per-tenant board — sub-boards add complexity for PYMEs that won't moderate.
// Status workflow: open → under_review → planned → in_progress → shipped | declined
// Ranking: weighted votes by lifetime MRR + recency decay + engagement bonus.

model FeatureRequest {
  id             String                       @id @default(uuid())
  title          String
  description    String
  status         String                       @default("open") // open|under_review|planned|in_progress|shipped|declined
  category       String? // ai|integrations|analytics|crm|billing|ux|other
  authorUserId   String                       @map("author_user_id")
  authorTenantId String?                      @map("author_tenant_id") // null if super_admin authored
  voteCount      Int                          @default(0) @map("vote_count") // raw count, denormalized for sort
  weightedScore  Float                        @default(0) @map("weighted_score") // ranking score, recomputed nightly
  commentCount   Int                          @default(0) @map("comment_count")
  embedding      Unsupported("vector(1536)")? // for duplicate detection
  mergedIntoId   String?                      @map("merged_into_id") // when admin merges duplicates
  shippedAt      DateTime?                    @map("shipped_at")
  declinedReason String?                      @map("declined_reason")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  votes      FeatureRequestVote[]
  comments   FeatureRequestComment[]
  mergedInto FeatureRequest?         @relation("MergedRequests", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  duplicates FeatureRequest[]        @relation("MergedRequests")

  @@index([status, weightedScore(sort: Desc)])
  @@index([authorTenantId])
  @@index([category])
  @@map("feature_requests")
  @@schema("public")
}

model FeatureRequestVote {
  id        String   @id @default(uuid())
  requestId String   @map("request_id")
  userId    String   @map("user_id")
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  request FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("feature_request_votes")
  @@schema("public")
}

model FeatureRequestComment {
  id           String   @id @default(uuid())
  requestId    String   @map("request_id")
  userId       String   @map("user_id")
  tenantId     String?  @map("tenant_id")
  body         String
  isAdminReply Boolean  @default(false) @map("is_admin_reply")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  request FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("feature_request_comments")
  @@schema("public")
}

// Subscribers receive email notifications when status changes or admin comments.
// Auto-subscribed on vote and on comment.
model FeatureRequestSubscriber {
  id        String   @id @default(uuid())
  requestId String   @map("request_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([requestId, userId])
  @@map("feature_request_subscribers")
  @@schema("public")
}

// ============================================
// EXTERNAL CRM CONNECTIONS — Per-tenant OAuth links
// ============================================
// One row per (tenant, provider) connection. Tokens encrypted with AES-256-GCM
// using the same key+pattern as channel_accounts.access_token. We store the
// canonical refresh_token (where the provider supports it) so the adapter can
// silently refresh ahead of expiry. Field mappings + per-record correlation
// IDs live in tenant-schema tables (crm_field_mappings, crm_external_links).
model CrmConnection {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  provider            String // hubspot|pipedrive|kommo|zoho|salesforce
  status              String    @default("active") // active|expired|revoked|error
  externalAccountId   String?   @map("external_account_id") // hub_id / company_id / account domain
  externalAccountName String?   @map("external_account_name")
  accessToken         String    @map("access_token") // encrypted
  refreshToken        String?   @map("refresh_token") // encrypted
  tokenExpiresAt      DateTime? @map("token_expires_at")
  scopes              String[]  @default([])
  syncMode            String    @default("outbound") @map("sync_mode") // outbound|bidirectional
  lastSyncAt          DateTime? @map("last_sync_at")
  lastErrorAt         DateTime? @map("last_error_at")
  lastErrorMessage    String?   @map("last_error_message")
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([status])
  @@map("crm_connections")
  @@schema("public")
}

// ============================================
// SYSTEM UPDATES — Platform-wide changelogs & announcements
// ============================================
model SystemUpdate {
  id          String   @id @default(uuid())
  version     String
  date        DateTime @default(now())
  title       Json     // e.g. { "es": "...", "en": "..." }
  description Json     // e.g. { "es": "...", "en": "..." }
  features    Json     // array of: { type: 'new'|'improved'|'fixed', title: { es, en, pt, fr }, desc: { es, en, pt, fr }, image?: string }
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_updates")
  @@schema("public")
}

// ============================================
// API KEYS — Public REST API authentication
// ============================================
model ApiKey {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  keyPrefix    String    @map("key_prefix") @db.VarChar(12)
  keyHash      String    @unique @map("key_hash") @db.VarChar(128)
  name         String    @db.VarChar(255)
  scopes       String[]  @default([])
  rateLimitRpm Int       @default(60) @map("rate_limit_rpm")
  lastUsedAt   DateTime? @map("last_used_at")
  expiresAt    DateTime? @map("expires_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdBy    String?   @map("created_by")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([tenantId], map: "idx_api_keys_tenant")
  @@index([keyPrefix], map: "idx_api_keys_prefix")
  @@map("api_keys")
  @@schema("public")
}

// ============================================
// AUTOMATION TEMPLATES — Pre-built automation catalog
// ============================================
model AutomationTemplate {
  id              String   @id @default(uuid())
  name            Json
  description     Json?
  category        String   @db.VarChar(100)
  industry        String?  @db.VarChar(100)
  icon            String?  @db.VarChar(50)
  triggerConfig   Json     @map("trigger_config")
  actionsConfig   Json     @map("actions_config")
  variables       Json     @default("[]")
  isActive        Boolean  @default(true) @map("is_active")
  popularityCount Int      @default(0) @map("popularity_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([category], map: "idx_automation_templates_category")
  @@index([industry], map: "idx_automation_templates_industry")
  @@map("automation_templates")
  @@schema("public")
}


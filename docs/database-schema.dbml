  calories int
  is_available boolean [default: true]
  is_active boolean [default: true]
  sort_order int [default: 0]
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.food_orders {
  id uuid [pk]
  contact_id uuid
  conversation_id uuid
  order_type varchar(20) [not null, default: 'delivery', note: 'delivery|pickup|dine_in']
  customer_name varchar(255)
  customer_phone varchar(50)
  delivery_address text
  delivery_notes text
  table_number varchar(50)
  subtotal decimal(10,2) [default: 0]
  delivery_fee decimal(10,2) [default: 0]
  discount decimal(10,2) [default: 0]
  total decimal(10,2) [default: 0]
  currency varchar(10) [default: 'COP']
  payment_method varchar(50)
  payment_status varchar(20) [default: 'pending']
  status varchar(20) [default: 'received', note: 'received|preparing|ready|delivered|cancelled']
  estimated_delivery_at timestamptz
  notes text
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.food_order_items {
  id uuid [pk]
  order_id uuid [ref: > tenant.food_orders.id]
  menu_item_id uuid [ref: > tenant.menu_items.id]
  name_snapshot varchar(255) [not null]
  quantity int [not null, default: 1]
  unit_price decimal(10,2) [not null, default: 0]
  modifiers jsonb [default: '[]']
  special_instructions text
  subtotal decimal(10,2) [not null, default: 0]
  created_at timestamptz [default: `now()`]
}

Table tenant.menu_promotions {
  id uuid [pk]
  title varchar(255) [not null]
  description text
  discount_type varchar(20) [default: 'percent']
  discount_value decimal(10,2) [default: 0]
  valid_from timestamptz
  valid_to timestamptz
  applicable_days jsonb [default: '[]']
  applicable_hours varchar(50)
  min_order_amount decimal(10,2)
  is_active boolean [default: true]
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// Gimnasios
Table tenant.membership_plans {
  id uuid [pk]
  name varchar(255) [not null]
  description text
  duration_days int [not null]
  price decimal(10,2) [not null, default: 0]
  currency varchar(10) [default: 'COP']
  class_credits_per_period int
  personal_training_credits int [default: 0]
  guest_passes int [default: 0]
  freeze_allowance_days int [default: 0]
  perks jsonb [default: '[]']
  is_active boolean [default: true]
  sort_order int [default: 0]
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.members {
  id uuid [pk]
  contact_id uuid [ref: > tenant.contacts.id]
  plan_id uuid [ref: > tenant.membership_plans.id]
  member_number varchar(50)
  joined_at date
  current_period_start date
  current_period_end date
  frozen_from date
  frozen_until date
  frozen_days_used int [default: 0]
  class_credits_remaining int
  personal_training_remaining int [default: 0]
  guest_passes_remaining int [default: 0]
  auto_renew boolean [default: false]
  status varchar(20) [default: 'active', note: 'active|frozen|expired|cancelled']
  notes text
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.fitness_classes {
  id uuid [pk]
  name varchar(255) [not null]
  description text
  class_type varchar(100)
  instructor_name varchar(255)
  instructor_user_id uuid
  scheduled_at timestamptz [not null]
  duration_minutes int [not null, default: 60]
  max_capacity int [not null, default: 20]
  available_spots int [not null, default: 20]
  room varchar(100)
  level varchar(50)
  credits_required int [default: 1]
  is_cancelled boolean [default: false]
  cancellation_reason text
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.class_bookings {
  id uuid [pk]
  class_id uuid [ref: > tenant.fitness_classes.id]
  member_id uuid [ref: > tenant.members.id]
  contact_id uuid
  status varchar(20) [default: 'confirmed', note: 'confirmed|waitlist|cancelled|attended|no_show']
  booked_at timestamptz [default: `now()`]
  cancelled_at timestamptz
  credits_used int [default: 1]
  metadata jsonb [default: '{}']
  indexes { (class_id, member_id) [unique, note: 'parcial confirmed/waitlist/attended']; (member_id, booked_at) }
}

Table tenant.member_check_ins {
  id uuid [pk]
  member_id uuid [ref: > tenant.members.id]
  checked_in_at timestamptz [default: `now()`]
  method varchar(20) [default: 'manual', note: 'manual|qr|rfid|facial']
  class_id uuid
  metadata jsonb [default: '{}']
}

// Educación (cohorts/enrollments/placement) — courses arriba
Table tenant.course_cohorts {
  id uuid [pk]
  course_id uuid [ref: > tenant.courses.id]
  cohort_code varchar(100)
  instructor_name varchar(255)
  instructor_user_id uuid
  starts_at date [not null]
  ends_at date
  schedule varchar(255)
  max_capacity int [not null, default: 20]
  available_seats int [not null, default: 20]
  room varchar(100)
  meeting_url varchar(500)
  status varchar(20) [default: 'open', note: 'open|full|cancelled|finished']
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.enrollments {
  id uuid [pk]
  cohort_id uuid [ref: > tenant.course_cohorts.id]
  course_id uuid [ref: > tenant.courses.id]
  contact_id uuid
  student_name varchar(255) [not null]
  student_email varchar(255)
  student_phone varchar(50)
  enrolled_at timestamptz [default: `now()`]
  status varchar(20) [default: 'enrolled', note: 'enrolled|active|completed|dropped|refunded']
  payment_status varchar(20) [default: 'pending']
  amount_paid decimal(10,2) [default: 0]
  completion_percent int [default: 0]
  final_grade varchar(20)
  completed_at date
  notes text
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.placement_tests {
  id uuid [pk]
  contact_id uuid
  subject varchar(100)
  scheduled_at timestamptz
  completed_at timestamptz
  result_level varchar(50)
  score decimal(5,2)
  test_url varchar(500)
  status varchar(20) [default: 'pending', note: 'pending|scheduled|completed|expired']
  notes text
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// Seguros
Table tenant.insurance_plans {
  id uuid [pk]
  name varchar(255) [not null]
  description text
  insurance_type varchar(50) [not null, note: 'vida|salud|auto|hogar|empresarial|viaje']
  coverage_level varchar(50)
  monthly_premium_min decimal(10,2)
  monthly_premium_max decimal(10,2)
  deductible decimal(10,2)
  max_coverage decimal(15,2)
  currency varchar(10) [default: 'COP']
  covers jsonb [default: '[]']
  excludes jsonb [default: '[]']
  min_age int
  max_age int
  is_active boolean [default: true]
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.insurance_quotes {
  id uuid [pk]
  contact_id uuid
  plan_id uuid [ref: > tenant.insurance_plans.id]
  applicant_name varchar(255)
  applicant_age int
  applicant_email varchar(255)
  applicant_phone varchar(50)
  applicant_data jsonb [default: '{}']
  monthly_premium decimal(10,2)
  annual_premium decimal(10,2)
  currency varchar(10) [default: 'COP']
  valid_until date
  status varchar(20) [default: 'draft', note: 'draft|sent|accepted|rejected|expired']
  agent_user_id uuid
  notes text
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.insurance_policies {
  id uuid [pk]
  policy_number varchar(100) [unique, not null]
  contact_id uuid
  plan_id uuid [ref: > tenant.insurance_plans.id]
  quote_id uuid [ref: > tenant.insurance_quotes.id]
  policyholder_name varchar(255) [not null]
  monthly_premium decimal(10,2) [not null]
  currency varchar(10) [default: 'COP']
  starts_at date [not null]
  ends_at date
  status varchar(20) [default: 'active', note: 'active|suspended|expired|cancelled']
  next_payment_at date
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.insurance_claims {
  id uuid [pk]
  policy_id uuid [ref: > tenant.insurance_policies.id]
  claim_number varchar(100)
  incident_type varchar(100)
  incident_at date
  description text
  claimed_amount decimal(15,2)
  approved_amount decimal(15,2)
  status varchar(30) [default: 'submitted', note: 'submitted|reviewing|approved|paid|rejected']
  filed_via varchar(20) [default: 'whatsapp']
  documents jsonb [default: '[]']
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// Servicios a domicilio (plomería/electricidad/...)
Table tenant.service_requests {
  id uuid [pk]
  contact_id uuid
  conversation_id uuid
  service_type varchar(100) [not null, note: 'plomeria|electricidad|fumigacion|limpieza|jardineria|other']
  urgency varchar(20) [default: 'normal', note: 'emergencia|alta|normal|flexible']
  customer_name varchar(255)
  customer_phone varchar(50)
  address text
  address_notes text
  city varchar(100)
  issue_description text
  preferred_date date
  preferred_time_window varchar(50)
  estimated_duration_minutes int
  estimated_cost decimal(10,2)
  currency varchar(10) [default: 'COP']
  assigned_technician_id uuid
  assigned_technician_name varchar(255)
  scheduled_at timestamptz
  completed_at timestamptz
  status varchar(30) [default: 'pending', note: 'pending|quoted|scheduled|dispatched|in_progress|completed|cancelled']
  photos jsonb [default: '[]']
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// Fotografía
Table tenant.photo_sessions {
  id uuid [pk]
  contact_id uuid
  conversation_id uuid
  session_type varchar(50) [not null, note: 'wedding|portrait|event|product|family|newborn|other']
  package_name varchar(255)
  package_description text
  client_name varchar(255)
  client_phone varchar(50)
  scheduled_at timestamptz
  duration_minutes int
  location text
  deliverables jsonb [default: '[]']
  deliverable_count int
  delivered_count int [default: 0]
  gallery_url text
  gallery_password varchar(100)
  delivery_due_at date
  delivered_at timestamptz
  price decimal(10,2)
  currency varchar(10) [default: 'COP']
  deposit_paid decimal(10,2) [default: 0]
  status varchar(30) [default: 'scheduled', note: 'scheduled|in_progress|delivered|cancelled']
  notes text
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// Staff scheduling (verticales con agenda por profesional)
Table tenant.staff_members {
  id uuid [pk]
  name text [not null]
  email text
  phone text
  role text [default: 'stylist']
  avatar_url text
  specialties text[] [default: '{}']
  is_active boolean [default: true]
  sort_order int [default: 0]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table tenant.staff_schedules {
  id uuid [pk]
  staff_id uuid [ref: > tenant.staff_members.id]
  day_of_week int [not null, note: '0..6']
  start_time time [not null]
  end_time time [not null]
  is_active boolean [default: true]
  indexes { (staff_id, day_of_week) [unique] }
}

Table tenant.staff_service_links {
  id uuid [pk]
  staff_id uuid [ref: > tenant.staff_members.id]
  service_id uuid
  duration_override_min int
  price_override int
  indexes { (staff_id, service_id) [unique] }
}

Table tenant.staff_breaks {
  id uuid [pk]
  staff_id uuid [ref: > tenant.staff_members.id]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  reason text
}

// Concesionarios / vehículos
Table tenant.vehicles {
  id uuid [pk]
  make text [not null]
  model text [not null]
  year int [not null]
  trim_level text
  vin text
  license_plate text
  color text
  fuel_type text [default: 'gasoline']
  transmission text [default: 'automatic']
  mileage_km int [default: 0]
  condition text [default: 'new']
  price_cents int [not null]
  currency text [default: 'COP']
  status text [default: 'available']
  category text [default: 'sedan']
  features text[] [default: '{}']
  photos text[] [default: '{}']
  description text
  location text
  is_featured boolean [default: false]
  acquired_at date
  sold_at date
  sold_price_cents int
  buyer_contact_id uuid
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  indexes { status; (make, model) }
}

Table tenant.vehicle_inquiries {
  id uuid [pk]
  vehicle_id uuid [ref: > tenant.vehicles.id]
  contact_id uuid
  contact_name text
  contact_phone text
  contact_email text
  inquiry_type text [default: 'info']
  notes text
  status text [default: 'new']
  assigned_to uuid
  created_at timestamptz [default: `now()`]
}

Table tenant.test_drives {
  id uuid [pk]
  vehicle_id uuid [ref: > tenant.vehicles.id]
  contact_id uuid
  contact_name text [not null]
  contact_phone text
  scheduled_date date [not null]
  scheduled_time time [not null]
  duration_min int [default: 30]
  status text [default: 'scheduled']
  notes text
  assigned_to uuid
  created_at timestamptz [default: `now()`]
}


// ═══════════════════════════════════════════════════════════════════════
// Relaciones cross-schema (lógicas — sin FK real por schema-per-tenant)
// ═══════════════════════════════════════════════════════════════════════
// • public.tenants.schema_name  ──▶  nombre del schema que contiene todas las tablas tenant.*
// • public.channel_accounts     ──▶  tenant.conversations.channel_account_id (multi-cuenta por tipo)
// • public.whatsapp_onboardings ──▶  tenant.whatsapp_channels.onboarding_id
// • public.fiscal_invoices      ──▶  cobros reales (billing_payments) → factura DIAN vía Factus

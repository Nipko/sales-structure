FROM node:20-alpine AS builder

WORKDIR /repo/apps/landing

ENV COREPACK_ENABLE_STRICT=0
RUN corepack disable 2>/dev/null || true

# Copy only landing app files (standalone, no monorepo deps)
COPY apps/landing/package.json apps/landing/package-lock.json* ./

# Install dependencies
RUN npm install

# Copy source (public assets + src + messages)
COPY apps/landing/public/ ./public/
COPY apps/landing/src/ ./src/
COPY apps/landing/messages/ ./messages/
COPY apps/landing/scripts/ ./scripts/
COPY apps/landing/next.config.ts apps/landing/tsconfig.json apps/landing/postcss.config.mjs ./

# The Wave-0 marketing contract cross-checks visible capabilities and plan
# quotas against backend source. Keep those inputs inside the build stage so a
# direct Docker build cannot bypass the same fail-closed gate used by CI.
COPY apps/api/prisma/seed-billing-plans.js /repo/apps/api/prisma/seed-billing-plans.js
COPY apps/api/src/ /repo/apps/api/src/
COPY apps/api/scripts/run-vertical-contract-matrix.cjs /repo/apps/api/scripts/run-vertical-contract-matrix.cjs
COPY packages/shared/src/ /repo/packages/shared/src/
COPY docs/vertical-competitive-evidence.json docs/vertical-competitive-matrix-2026-08.md /repo/docs/

# Build static export
RUN npm run build

# ---- Production image (nginx serves static files) ----
FROM nginx:alpine

COPY --from=builder /repo/apps/landing/out /usr/share/nginx/html

RUN echo 'server { \
    listen 80; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri.html $uri/ /index.html; \
    } \
    location /_next/ { \
        expires 365d; \
        add_header Cache-Control "public, immutable"; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

  "faqs": [
    {
      "id": "4cb51957-ce02-4e96-bbe1-615207b39799",
      "answer": "La comisión depende del tipo de operación. Te confirmo la cifra exacta antes de avanzar; si quieres, agendamos una reunión para revisarla con calma.",
      "category": "costos",
      "question": "¿Cuál es la comisión?",
      "created_at": "2026-10-02T21:19:15.249265",
      "updated_at": "2026-10-02T21:19:15.249265",
      "is_published": true
    },
    {
      "id": "f6156ff3-724e-4c20-8a7c-b57a6679ad14",
      "answer": "Podemos orientarte sobre opciones de crédito hipotecario y contarte con qué entidades trabajamos. Agenda una asesoría y lo revisamos juntos.",
      "category": "financiacion",
      "question": "¿Ofrecen financiación?",
      "created_at": "2026-10-02T21:19:15.249265",
      "updated_at": "2026-10-02T21:19:15.249265",
      "is_published": true
    },
    {
      "id": "6c3a8b64-002c-42bf-a614-a564ec1b7723",
      "answer": "Puedo agendar una visita para ti ahora mismo. Dime cuál propiedad te interesa y tus horarios disponibles.",
      "category": "visitas",
      "question": "¿Cómo agendo una visita?",
      "created_at": "2026-10-02T21:19:15.249265",
      "updated_at": "2026-10-02T21:19:15.249265",
      "is_published": true
    },
    {
      "id": "94c7f4d7-3eff-4a03-a0d3-7528f89aa05d",
      "answer": "Depende de si compras o arriendas y de la entidad que participe. Cuéntame cuál es tu caso y un asesor te pasa la lista exacta de documentos.",
      "category": "documentos",
      "question": "¿Qué documentos necesito?",
      "created_at": "2026-10-02T21:19:15.249265",
      "updated_at": "2026-10-02T21:19:15.249265",
      "is_published": true
    },
    {
      "id": "c926edf1-4e83-45d9-a99e-78e5fdbe7ace",
      "answer": "La financiación depende de cada propiedad y de tu perfil. Cuéntame el rango de precio y la zona que te interesa, y reviso qué opciones aplican en tu caso.",
      "category": "financiacion",
      "question": "¿Tienen opciones con financiación / crédito hipotecario?",
      "created_at": "2026-10-02T21:19:15.249265",
      "updated_at": "2026-10-02T21:19:15.249265",
      "is_published": true
    },
    {
      "id": "267a03dd-2d0e-4d3c-aa24-a1884ba9ac3c",
      "answer": "Te muestro las propiedades disponibles según tu interés y agendamos visita con el asesor de zona. ¿Qué presupuesto manejas y en qué zona te interesa?",
      "category": "visitas",
      "question": "¿Cómo agendo una visita a la propiedad?",
      "created_at": "2026-10-02T21:19:15.249265",
      "updated_at": "2026-10-02T21:19:15.249265",
      "is_published": true
    },
    {
      "id": "35c3436b-7e5d-4335-ad07-788b1030aa68",
      "answer": "Los honorarios dependen de si es arriendo o venta y del inmueble. Te los confirma el asesor sobre la propiedad concreta que te interese, antes de cualquier compromiso.",
      "category": "comisiones",
      "question": "¿Cuánto cobran de comisión / honorarios?",
      "created_at": "2026-10-02T21:19:15.249265",
      "updated_at": "2026-10-02T21:19:15.249265",
      "is_published": true
    },
    {
      "id": "bb703bf6-7044-47ed-a4c4-f42c2fe9a11f",
      "answer": "Arriendo: cédula, certificado laboral, extractos bancarios y codeudor (depende del inmueble). Compra: capacidad crediticia y separación. Te detallo cuando definamos el inmueble.",
      "category": "documentos",
      "question": "¿Qué documentos necesito para arrendar / comprar?",
      "created_at": "2026-10-02T21:19:15.249265",
      "updated_at": "2026-10-02T21:19:15.249265",
      "is_published": true
    },
    {
      "id": "f22f224d-fd0a-4602-b350-83b158228874",
      "answer": "En arriendo: la administración generalmente NO está incluida y se paga aparte. En venta: el precio publicado es del inmueble; la administración mensual se informa en la visita.",
      "category": "costos",
      "question": "¿La administración / cuota de condominio está incluida en el precio?",
      "created_at": "2026-10-02T21:19:15.249265",
      "updated_at": "2026-10-02T21:19:15.249265",
      "is_published": true
    },
    {
      "id": "c758ab27-1d0e-47a7-af60-06df0cf7cae6",
      "answer": "Tenemos opciones en venta y arriendo. Cuéntame tu presupuesto, zona de interés y tipo de inmueble y te muestro las que mejor encajan.",
      "category": "propiedades",
      "question": "¿Qué propiedades tienen disponibles?",
      "created_at": "2026-10-02T21:19:15.249265",
      "updated_at": "2026-10-02T21:19:15.249265",
      "is_published": true
    }
  ],
